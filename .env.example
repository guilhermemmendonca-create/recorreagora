# ---------------------------------------------------------------------------
# Obrigatório
# ---------------------------------------------------------------------------
# NUNCA prefixe com NEXT_PUBLIC_ — isso vazaria a chave para o bundle client.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Modelo de extração
# ---------------------------------------------------------------------------
# claude-sonnet-5 é o default (escolha do spec). Se o critério de aceite 3
# (data_expedicao correta ou null em 10/10) não bater, o primeiro ajuste a
# testar é claude-opus-5 — é o campo que sustenta a tese jurídica inteira.
EXTRACTION_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
EXTRACTION_EFFORT=medium

# ---------------------------------------------------------------------------
# Limites de upload (proteção de custo — a rota é pública, sem login)
# ---------------------------------------------------------------------------
MAX_IMAGES=6
MAX_IMAGE_BYTES=6291456
MAX_TOTAL_BYTES=20971520

# ---------------------------------------------------------------------------
# Rate limit por IP
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=3600
# Sem Upstash o limite é in-memory (por instância serverless) — parcial.
# Em produção configure os dois para ter um limite real e compartilhado.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (opcional; quando a secret existe, o token vira obrigatório)
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
